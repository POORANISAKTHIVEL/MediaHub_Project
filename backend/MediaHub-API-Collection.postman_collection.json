  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Creator\",\n  \"email\": \"alice@mediahub.com\",\n  \"password\": \"SecurePass123\",\n  \"phone\": \"+919876543210\",\n  \"country\": \"IN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/media/mediaHub/iam/auth/register/v1.0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media",
                "mediaHub",
                "iam",
                "auth",
                "register",
                "v1.0"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('token', jsonData.token);",
                  "    pm.environment.set('userId', jsonData.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@mediahub.com\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/media/mediaHub/iam/auth/login/v1.0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media",
                "mediaHub",
                "iam",
                "auth",
                "login",
                "v1.0"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/media/mediaHub/iam/auth/logout/v1.0?userId={{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media",
                "mediaHub",
                "iam",
                "auth",
                "logout",
                "v1.0"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('token', jsonData.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/media/mediaHub/iam/auth/refreshToken/v1.0?userId={{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media",
                "mediaHub",
                "iam",
                "auth",
                "refreshToken",
                "v1.0"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
